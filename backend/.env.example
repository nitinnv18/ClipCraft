# Database & Queue
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clipcraft
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Groq Whisper & Llama API)
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Storage Configuration (Cloudinary / Local)
STORAGE_MODE=cloud
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security & CORS
JWT_SECRET=super-secret-clipcraft-production-key-change-me
APP_URL=http://localhost:3000
USER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://clipcraft.vercel.app,https://clipcraft-v1.vercel.app,https://clipcraft-v1-admin.vercel.app,https://clipcraft-admin.vercel.app
ALLOWED_ORIGIN_REGEX=^https:\/\/clipcraft(-team)?\.vercel\.app$

# Super Admin seed credentials
SUPER_ADMIN_EMAIL=admin@clipcraft.io
SUPER_ADMIN_PASSWORD=Admin@ClipCraft2026!
