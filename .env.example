# Database & Queue
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clipcraft
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Google Gemini API)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Storage Configuration (Cloudinary / Local)
STORAGE_MODE=cloud
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security & CORS
JWT_SECRET=super-secret-clipcraft-production-key-change-me
APP_URL=http://localhost:3000
USER_APP_URL=https://clipcraft-user.vercel.app
ADMIN_APP_URL=https://clipcraft-admin.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.vercel.app
NEXT_PUBLIC_API_URL=https://clipcraft-backend.onrender.com

# Super Admin seed credentials
SUPER_ADMIN_EMAIL=admin@clipcraft.io
SUPER_ADMIN_PASSWORD=Admin@ClipCraft2026!

# RapidAPI YouTube Downloader Stream Integration (100% Cloud Bypass)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=youtube-media-downloader.p.rapidapi.com
